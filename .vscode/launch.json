{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bicount - Préproduction conflits expérimentale (Android)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "env": {
        "BICOUNT_LOCAL_PREPROD_BUILD": "1"
      },
      "preLaunchTask": "Bicount : préparer la préproduction locale",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/supabase/.temp/bicount_preprod_defines.json",
        "--dart-define=BICOUNT_EXPERIMENTAL_CONDITIONAL=true"
      ]
    },
    {
      "name": "Bicount - Préproduction locale (Android)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "env": {
        "BICOUNT_LOCAL_PREPROD_BUILD": "1"
      },
      "preLaunchTask": "Bicount : préparer la préproduction locale",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/supabase/.temp/bicount_preprod_defines.json"
      ]
    },
    {
      "name": "Bicount - Configuration habituelle",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug"
    }
  ]
}
