<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme-following surface. The light/dark variants used by the data layouts
  are picked in Kotlin from the palette the app publishes; this one relies on
  resource qualifiers instead, so it stays correct even when no data has ever
  been published (fresh install) and in the widget picker preview.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFF9F9F9" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#FFE8E8E8" />
</shape>
