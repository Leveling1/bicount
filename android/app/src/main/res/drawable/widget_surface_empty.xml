<?xml version="1.0" encoding="utf-8"?>
<!--
  Surface for the empty card only. Its fill matches the background baked into
  the logo asset (#F9F9F9 light / #1A1A1A dark), which is opaque: on the
  regular #2C2C2C surface the logo showed as a visible rectangle. The data
  layouts keep their own surface.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFF9F9F9" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#FFE8E8E8" />
</shape>
